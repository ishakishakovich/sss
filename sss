    row.Size=UDim2.new(1,-12,0,h or 30); row.BackgroundColor3=Color3.fromRGB(26,26,32)
    row.BorderSizePixel=0; row.Parent=parent
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,5); c.Parent=row
    row:SetAttribute("BaseName","")
    return row
end

local function makeToggle(parent, text, key, cb)
    local row = widgetRow(parent, 30); row:SetAttribute("BaseName", text:lower())
    local lbl = Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-70,1,0); lbl.Position=UDim2.new(0,12,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=text; lbl.TextColor3=Color3.fromRGB(200,200,210)
    lbl.Font=Enum.Font.GothamMedium; lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
    local sw = Instance.new("Frame"); sw.Size=UDim2.new(0,38,0,20); sw.Position=UDim2.new(1,-48,0.5,-10)
    sw.BackgroundColor3 = C[key] and Color3.fromRGB(255,0,100) or Color3.fromRGB(40,40,48); sw.Parent=row
    local swc=Instance.new("UICorner"); swc.CornerRadius=UDim.new(0,10); swc.Parent=sw
    local knob = Instance.new("Frame"); knob.Size=UDim2.new(0,16,0,16)
    knob.Position = UDim2.new(0, C[key] and 20 or 2, 0.5, -8)
    knob.BackgroundColor3=Color3.fromRGB(255,255,255); knob.Parent=sw
    local knc=Instance.new("UICorner"); knc.CornerRadius=UDim.new(0,8); knc.Parent=knob
    local btn = Instance.new("TextButton"); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=row
    btn.MouseButton1Click:Connect(function()
        C[key] = not C[key]
        TweenService:Create(sw, TweenInfo.new(0.18), {BackgroundColor3 = C[key] and Color3.fromRGB(255,0,100) or Color3.fromRGB(40,40,48)}):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {Position = UDim2.new(0, C[key] and 20 or 2, 0.5, -8)}):Play()
        if cb then cb(C[key]) end
    end)
end

local function makeSlider(parent, text, key, min, max, cb)
    local row = widgetRow(parent, 46); row:SetAttribute("BaseName", text:lower())
    local lbl = Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-20,0,18); lbl.Position=UDim2.new(0,12,0,3)
    lbl.BackgroundTransparency=1; lbl.TextColor3=Color3.fromRGB(200,200,210); lbl.Font=Enum.Font.GothamMedium; lbl.TextSize=12
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Text = text.."  ·  "..tostring(C[key]); lbl.Parent=row
    local bar = Instance.new("Frame"); bar.Size=UDim2.new(1,-24,0,6); bar.Position=UDim2.new(0,12,0,28)
    bar.BackgroundColor3=Color3.fromRGB(40,40,48); bar.Parent=row
    local barc=Instance.new("UICorner"); barc.CornerRadius=UDim.new(0,3); barc.Parent=bar
    local fill = Instance.new("Frame"); fill.Size=UDim2.new((C[key]-min)/(max-min),0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(255,0,100); fill.Parent=bar
    local fillc=Instance.new("UICorner"); fillc.CornerRadius=UDim.new(0,3); fillc.Parent=fill
    local dragBtn = Instance.new("TextButton"); dragBtn.Size=UDim2.new(1,0,3,0); dragBtn.Position=UDim2.new(0,0,-1,0)
    dragBtn.BackgroundTransparency=1; dragBtn.Text=""; dragBtn.Parent=bar
    local dragging=false
    local function setFromX(x)
        local rel = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local val = min + (max-min)*rel
        val = (max-min)>20 and math.floor(val+0.5) or math.floor(val*10+0.5)/10
        C[key]=val; fill.Size=UDim2.new(rel,0,1,0); lbl.Text = text.."  ·  "..tostring(val)
        if cb then cb(val) end
    end
    dragBtn.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
    UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then setFromX(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
end

local function makeDropdown(parent, text, key, options, cb)
    local row = widgetRow(parent, 30); row:SetAttribute("BaseName", text:lower())
    local lbl = Instance.new("TextLabel"); lbl.Size=UDim2.new(0.5,-12,1,0); lbl.Position=UDim2.new(0,12,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=text; lbl.TextColor3=Color3.fromRGB(200,200,210)
    lbl.Font=Enum.Font.GothamMedium; lbl.TextSize=12; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
    local btn = Instance.new("TextButton"); btn.Size=UDim2.new(0.45,-6,0,22); btn.Position=UDim2.new(0.55,0,0.5,-11)
    btn.BackgroundColor3=Color3.fromRGB(40,40,48); btn.BorderSizePixel=0; btn.Text=tostring(C[key])
    btn.TextColor3=Color3.fromRGB(255,255,255); btn.Font=Enum.Font.Gotham; btn.TextSize=11; btn.Parent=row
    local bc=Instance.new("UICorner"); bc.CornerRadius=UDim.new(0,4); bc.Parent=btn
    local idx=1; for i,o in ipairs(options) do if o==C[key] then idx=i break end end
    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1; C[key]=options[idx]; btn.Text=options[idx]
        if cb then cb(options[idx]) end
    end)
end

