local spinAngle = 0
local function updateMovement()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    if Config.movement.speedEnabled and hum.WalkSpeed ~= Config.movement.speedValue then
        hum.WalkSpeed = Config.movement.speedValue
    end
    if hum.UseJumpPower and hum.JumpPower ~= Config.movement.jumpPower then
        hum.JumpPower = Config.movement.jumpPower
    end
    if Config.movement.noclip then
        for _,v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
        end
    end
    if Config.movement.flyEnabled then
        local moveDir = Vector3.zero
        local camCF = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.yAxis end
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + moveDir.Unit * Config.movement.flySpeed * (1/60)
        end
        hrp.Velocity = Vector3.zero
    end
    if Config.movement.spinBot then
        spinAngle = spinAngle + 8
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinAngle), 0)
    end
    if Config.movement.infiniteJump and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
    end
end

--==================== FARM ====================--
local function getNearestTarget(range)
    local best, bestDist = nil, range or 500
    local myPos = getHRP() and getHRP().Position
    if not myPos then return nil end
    for _,plr in pairs(Players:GetPlayers()) do
        if not isValidTarget(plr) then continue end
        local hrp = getHRP(plr)
        if not hrp then continue end
        local d = (hrp.Position - myPos).Magnitude
        if d < bestDist then bestDist = d best = plr end
    end
    return best
end

local function updateFarm()
    if Config.farm.autoFarm then
        local t = getNearestTarget(Config.farm.farmRange)
        if t then
            local hrp, tHrp = getHRP(), getHRP(t)
            if hrp and tHrp then hrp.CFrame = CFrame.lookAt(hrp.Position, tHrp.Position) end
        end
    end
    if Config.farm.autoShoot and Target then
        safeCall(function() mouse1click() end)
    end
    if Config.farm.autoReload and LocalPlayer.Character then
        local wep = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
        if wep then safeCall(function() wep:Activate() end) end
    end
    if Config.farm.autoHeal then
        local hum = getHum()
        if hum and hum.Health < hum.MaxHealth then
            -- [CONFIG] hook real heal remote name
            fireRemote and fireRemote("Heal", "medkit")
        end
    end
end

