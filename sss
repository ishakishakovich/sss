local function fireRemote(name, ...)
    local rem = ReplicatedStorage:FindFirstChild(name, true)
    if rem and rem:IsA("RemoteEvent") then rem:FireServer(...) return true end
    return false
end
local function invokeRemote(name, ...)
    local rem = ReplicatedStorage:FindFirstChild(name, true)
    if rem and rem:IsA("RemoteFunction") then return rem:InvokeServer(...) end
    return nil
end

