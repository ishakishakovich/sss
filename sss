--==================== AIMBOT ====================--
local function getClosestToCursor(partName, fov, teamCheck)
    local best, bestDist = nil, fov
    local mouse = UserInputService:GetMouseLocation()
    for _,plr in pairs(Players:GetPlayers()) do
        if not isValidTarget(plr) then continue end
        local char = plr.Character
        local part = char and char:FindFirstChild(partName)
        if not part then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
        if d < bestDist then
            bestDist = d
            best = {player=plr, part=part}
        end
    end
    return best
end

local function predict(part, hum, mult)
    if not Config.aimbot.resolveVelocity or not hum then return part.Position end
    return part.Position + hum.MoveDirection * (Config.aimbot.prediction * Config.movement.speedValue)
end

local function aimAt(target)
    if not target then return end
    local part = target.part
    local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
    local pos = predict(part, hum)
    local camPos = Camera.CFrame.Position
    local dir = (pos - camPos).Unit
    local cf = CFrame.lookAt(camPos, camPos + dir)
    if Config.aimbot.smoothness >= 1 then
        Camera.CFrame = cf
    else
        Camera.CFrame = Camera.CFrame:Lerp(cf, 1 - Config.aimbot.smoothness)
    end
end

