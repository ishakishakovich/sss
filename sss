-- ============================================================
-- HELPERS
-- ============================================================
local function char(p) return p and p.Character end
local function hrp(p) local c=char(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function hum(p) local c=char(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function head(p) local c=char(p) return c and c:FindFirstChild("Head") end
local function alive(p) local h=hum(p) return h and h.Health>0 end
local function dist(a,b) return (a-b).Magnitude end
local function screen(pos) local s,on,d=Camera:WorldToViewportPoint(pos) return Vector2.new(s.X,s.Y),on,d end

local function isNPC(p)
    return p:FindFirstChild("NPC") ~= nil or p:GetAttribute("IsNPC") == true
end

local function isWhitelisted(p)
    for _,n in ipairs(C.whitelist) do
        if p.Name:lower():find(n:lower(),1,true) or p.DisplayName:lower():find(n:lower(),1,true) then
            return true
        end
    end
    return false
end

local function canHit(p)
    if p==LP then return false end
    if not alive(p) then return false end
    if isWhitelisted(p) then return false end
    if C.espSkipNpc and isNPC(p) then return false end
    return true
end

-- raycast visibility (modern Raycast API + fallback)
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true
local function visible(part)
    if not C.silWallCheck then return true end
    if not part then return false end
    rp.FilterDescendantsInstances = {LP.Character, part.Parent}
    local res = Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rp)
    return res == nil
end

