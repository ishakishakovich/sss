--==================== DRAWING ====================--
local Drawing = Drawing or {}
local drawings = {}
local function newDrawing(class, props)
    local d = Drawing.new(class)
    for k,v in pairs(props or {}) do safe(function() d[k]=v end) end
    table.insert(drawings, d)
    return d
end
local function clearDrawings()
    for _,d in ipairs(drawings) do safe(function() d:Remove() end) end
    drawings = {}
end

--==================== WHITELIST / TARGET ====================--
local Whitelist, Blacklist, Target = {}, {}, nil
local function addWhite(p) Whitelist[p]=true Blacklist[p]=nil end
local function addBlack(p) Blacklist[p]=true Whitelist[p]=nil end
local function isWhite(p) return Whitelist[p]==true end
local function isBlack(p) return Blacklist[p]==true end
local function isValidTarget(plr)
    if not plr or plr==LocalPlayer then return false end
    if isWhite(plr) then return false end
    local hum = getHum(plr)
    if not hum or hum.Health<=0 then return false end
    if Config.aimbot.teamCheck and LocalPlayer.Team and plr.Team==LocalPlayer.Team then return false end
    return true
end

--==================== AIM LIST ====================--
local AimList = {}
local AimListOrder = {}

local function addToAimList(plr)
    if not plr or plr==LocalPlayer then return end
    if AimList[plr] then return end
    AimList[plr] = true
    table.insert(AimListOrder, plr)
end
local function removeFromAimList(plr)
    if not AimList[plr] then return end
    AimList[plr] = nil
    for i,p in ipairs(AimListOrder) do
        if p == plr then table.remove(AimListOrder, i) break end
    end
end
local function toggleAimList(plr)
    if AimList[plr] then removeFromAimList(plr) else addToAimList(plr) end
end
local function clearAimList()
    for _,p in ipairs(AimListOrder) do AimList[p] = nil end
    AimListOrder = {}
end

