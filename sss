local Whitelist, Blacklist, Target = {}, {}, nil
local function addWhite(p) Whitelist[p]=true Blacklist[p]=nil end
local function addBlack(p) Blacklist[p]=true Whitelist[p]=nil end
local function isWhitelisted(p) return Whitelist[p]==true end
local function isBlacklisted(p) return Blacklist[p]==true end
local function isValidTarget(plr)
    if not plr or plr==LocalPlayer then return false end
    if isWhitelisted(plr) then return false end
    local hum = getHum(plr)
    if not hum or hum.Health<=0 then return false end
    if Config.aimbot.teamCheck and LocalPlayer.Team and plr.Team==LocalPlayer.Team then return false end
    return true
end

