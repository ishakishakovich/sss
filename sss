-- ============ MAIN LOOP ============
local function onUpdate()
    if not LocalPlayer.Character then return end
    
    -- Aimbot
    if Config.AimbotEnabled and UserInputService:IsKeyDown(Config.AimbotKeybind) then
        if Config.StickyAimbot and Target and isAlive(Target.player) then
            local part = getCharacter(Target.player) and getCharacter(Target.player):FindFirstChild(Config.TargetPart)
            if part then
                local screen, onScreen = worldToScreen(part.Position)
                if onScreen and (screen - UserInputService:GetMouseLocation()).Magnitude < Config.FOVRadius then
                    aimAt({player = Target.player, part = part, screen = screen})
                else
                    Target = nil
                end
            else
                Target = nil
            end
        else
            Target = getClosestTarget()
            if Target then aimAt(Target) end
        end
    end
    
    -- Triggerbot
    doTriggerBot()
    
    -- ESP
    updateESP()
    
    -- Fly
    updateFly()
    
    -- FOV circle
    if Config.ShowFOV and Config.AimbotEnabled then
        -- draw via Drawing API would go here, skipping for brevity (executor Drawing API)
    end
end

RunService.RenderStepped:Connect(onUpdate)

