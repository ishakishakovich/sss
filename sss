playerList.Parent = fPlayers

local plLay = Instance.new("UIListLayout"); plLay.Padding = UDim.new(0,4); plLay.Parent = playerList

local function refreshPlayerList()
    -- clear children except layout
    for _,ch in ipairs(playerList:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    updateLockCount()

    local players = Players:GetPlayers()
    table.sort(players, function(a,b)
        -- locked first, then alphabetical
        local al, bl = isLocked(a), isLocked(b)
        if al ~= bl then return al end
        return a.Name:lower() < b.Name:lower()
    end)

    for _,p in ipairs(players) do
        if p == LP then continue end
        local isL = isLocked(p)
        local isDead = not alive(p)

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 32)
        row.BackgroundColor3 = isL and Color3.fromRGB(50,20,30) or Color3.fromRGB(26,26,32)
        row.BorderSizePixel = 0
        row.Parent = playerList
        local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0,5); rc.Parent = row

        -- lock indicator dot
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 10, 0, 10)
        dot.Position = UDim2.new(0, 10, 0.5, -5)
        dot.BackgroundColor3 = isL and Color3.fromRGB(255,0,100) or (isDead and Color3.fromRGB(80,80,80) or Color3.fromRGB(80,80,90))
        dot.Parent = row
        local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(0,5); dc.Parent = dot

        -- name label
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, -130, 0.5, 0)
        nl.Position = UDim2.new(0, 26, 0, 2)
        nl.BackgroundTransparency = 1
        nl.Text = p.DisplayName
        nl.TextColor3 = isDead and Color3.fromRGB(120,120,120) or Color3.fromRGB(230,230,240)
        nl.Font = Enum.Font.GothamMedium
        nl.TextSize = 12
        nl.TextXAlignment = Enum.TextXAlignment.Left
        nl.Parent = row

        -- @username
        local ul = Instance.new("TextLabel")
        ul.Size = UDim2.new(1, -130, 0.5, 0)
        ul.Position = UDim2.new(0, 26, 0.5, 0)
        ul.BackgroundTransparency = 1
        ul.Text = "@" .. p.Name .. (isDead and "  ·  dead" or "  ·  " .. math.floor(dist(hrp(LP) and hrp(LP).Position or Vector3.zero, hrp(p) and hrp(p).Position or Vector3.zero)) .. " studs")
        ul.TextColor3 = Color3.fromRGB(130,130,140)
        ul.Font = Enum.Font.Gotham
        ul.TextSize = 10
        ul.TextXAlignment = Enum.TextXAlignment.Left
        ul.Parent = row

        -- LOCK button
        local lockBtn = Instance.new("TextButton")
        lockBtn.Size = UDim2.new(0, 80, 0, 24)
        lockBtn.Position = UDim2.new(1, -88, 0.5, -12)
        lockBtn.BackgroundColor3 = isL and Color3.fromRGB(255,0,100) or Color3.fromRGB(40,40,48)
        lockBtn.BorderSizePixel = 0
        lockBtn.Text = isL and "UNLOCK" or "LOCK"
        lockBtn.TextColor3 = isL and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,210)
        lockBtn.Font = Enum.Font.GothamBold
        lockBtn.TextSize = 11
        lockBtn.Parent = row
        local lbc = Instance.new("UICorner"); lbc.CornerRadius = UDim.new(0,4); lbc.Parent = lockBtn

        lockBtn.MouseButton1Click:Connect(function()
            if isLocked(p) then
                unlockPlayer(p)
            else
                lockPlayer(p)
            end
            refreshPlayerList()
        end)
    end

    -- empty state
    if #players <= 1 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -20, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = "no other players in server"
        empty.TextColor3 = Color3.fromRGB(120,120,130)
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 12
        empty.Parent = playerList
    end
end

