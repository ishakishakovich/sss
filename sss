--==================== CONFIG SAVE/LOAD ====================--
local function serialize(tbl, indent)
    indent = indent or ""
    if type(tbl) ~= "table" then return string.format("%q", tostring(tbl)) end
    local parts = {"{\n"}
    for k,v in pairs(tbl) do
        parts[#parts+1] = indent .. "  [" .. serialize(k) .. "] = " .. serialize(v, indent .. "  ") .. ",\n"
    end
    parts[#parts+1] = indent .. "}"
    return table.concat(parts)
end
local function saveConfig(path)
    path = path or "vex_config.lua"
    local f = io.open(path, "w")
    if not f then return false end
    f:write("return " .. serialize(Config))
    f:close()
    return true
end
local function loadConfig(path)
    path = path or "vex_config.lua"
    local f = io.open(path, "r")
    if not f then return false end
    local content = f:read("*a") f:close()
    local chunk = loadstring(content)
    if chunk then
        local res = chunk()
        if type(res)=="table" then
            for k,v in pairs(res) do
                if type(v)=="table" and Config[k] then
                    for k2,v2 in pairs(v) do Config[k][k2]=v2 end
                else Config[k]=v end
            end
            return true
        end
    end
    return false
end

