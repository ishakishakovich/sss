local function getAllPlayersSortedByDist()
    local list = {}
    local myPos = getHRP() and getHRP().Position
    if not myPos then return list end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local hrp = getHRP(p)
        if hrp then table.insert(list, {plr=p, dist=(hrp.Position-myPos).Magnitude}) end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    return list
end
local function reloadCharacter()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
    end
end
local function killAllAI()
    for _,v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Humanoid") and v.Parent ~= LocalPlayer.Character then
            if not Players:GetPlayerFromCharacter(v.Parent) then v.Health = 0 end
        end
    end
end
local function spamJump()
    local hrp, hum = getHRP(), getHum()
    if hrp and hum then
        hum.Jump = true
        task.wait()
        hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
    end
end
local function getAllTools()
    local tools = {}
    if LocalPlayer.Backpack then
        for _,v in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") then table.insert(tools, v) end
        end
    end
    if LocalPlayer.Character then
        for _,v in ipairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") then table.insert(tools, v) end
        end
    end
    return tools
end
local function equipTool(name)
    for _,t in ipairs(getAllTools()) do
        if t.Name:lower():find(name:lower()) then
            local hum = getHum()
            if hum then hum:EquipTool(t) end
            return true
        end
    end
    return false
end
local function dropAllTools()
    for _,t in ipairs(getAllTools()) do
        if t.Parent == LocalPlayer.Character then
            t.Parent = Workspace
        end
    end
end

