local targetTick = 0
local function updateTargetDisplay()
    targetTick += 1
    if targetTick % 15 ~= 0 then return end
    if #AimListOrder == 0 then
        targetLabel.Visible = false
        return
    end
    local names = {}
    for _, p in ipairs(AimListOrder) do
        if p.Parent then table.insert(names, p.Name) end
    end
    if #names == 0 then
        targetLabel.Visible = false
        return
    end
    targetLabel.Visible = true
    targetLabel.Text = "AIM (" .. #names .. "): " .. table.concat(names, ", ")
end

