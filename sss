local loopFarmRunning = false
local function startLoopFarm()
    if loopFarmRunning then return end
    loopFarmRunning = true
    task.spawn(function()
        while loopFarmRunning do
            local t = getNearestTarget(Config.farm.farmRange)
            if t then
                local hrp, tHrp = getHRP(), getHRP(t)
