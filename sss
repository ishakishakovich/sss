--==================== AIMBOT ====================--
local function getClosestToCursor(partName, fov)
    local best, bestDist = nil, fov
    local mouse = UserInputService:GetMouseLocation()
    for _,plr in pairs(Players:GetPlayers()) do
        if not isValidTarget(plr) then continue end
        local char = plr.Character
        local part = char and char:FindFirstChild(partName)
        if not part then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
        if d < bestDist then
            bestDist = d
            best = {player=plr, part=part}
        end
    end
    return best
end
local function getMultiAimTarget(partName, fov)
    if #AimListOrder == 0 then return nil end
    local mouse = UserInputService:GetMouseLocation()
    local best, bestDist = nil, fov
    local toRemove = {}
    for _, plr in ipairs(AimListOrder) do
        if not plr.Parent then table.insert(toRemove, plr) continue end
        if not isValidTarget(plr) then continue end
        local char = plr.Character
        local part = char and char:FindFirstChild(partName)
        if not part then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
        if d < bestDist then
            bestDist = d
            best = {player=plr, part=part}
        end
    end
    for _, p in ipairs(toRemove) do removeFromAimList(p) end
    return best
end
local function aimAt(target)
    if not target or not target.part then return end
    local part = target.part
    local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
    local pos = part.Position
    if hum and Config.aimbot.prediction > 0 then
        pos = pos + hum.MoveDirection * (Config.aimbot.prediction * Config.movement.speedValue)
    end
    local camPos = Camera.CFrame.Position
    local dir = (pos - camPos).Unit
    local cf = CFrame.lookAt(camPos, camPos + dir)
    if Config.aimbot.smoothness >= 1 then
        Camera.CFrame = cf
    else
        Camera.CFrame = Camera.CFrame:Lerp(cf, 1 - Config.aimbot.smoothness)
    end
end
local aimHeld = false
track(UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.UserInputType == Config.aimbot.key then aimHeld = true end
end))
track(UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Config.aimbot.key then aimHeld = false end
end))
local function updateAimbot()
    if not Config.aimbot.enabled or not aimHeld then return end
    local target
    if #AimListOrder > 0 then
        target = getMultiAimTarget(Config.aimbot.part, Config.aimbot.fov)
    elseif Target and isValidTarget(Target) then
        local part = Target.Character and Target.Character:FindFirstChild(Config.aimbot.part)
        if part then target = {player=Target, part=part} end
    else
        target = getClosestToCursor(Config.aimbot.part, Config.aimbot.fov)
    end
    if target then aimAt(target) end
end

--==================== MOVEMENT ====================--
local noclipCache = {}
local function updateNoclip()
    local char = LocalPlayer.Character
    if not char then noclipCache = {} return end
    if Config.movement.noclip then
        if next(noclipCache) == nil then
            for _,v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then noclipCache[v] = true end
            end
        end
        for part in pairs(noclipCache) do
            if part.Parent and part.CanCollide then part.CanCollide = false end
        end
    else
        if next(noclipCache) ~= nil then
            for part in pairs(noclipCache) do
                if part.Parent then part.CanCollide = true end
            end
            noclipCache = {}
        end
    end
end
local wasFlying = false
local function updateMovement()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if Config.movement.speedEnabled then
        if hum.WalkSpeed ~= Config.movement.speedValue then hum.WalkSpeed = Config.movement.speedValue end
    elseif hum.WalkSpeed > 20 and hum.WalkSpeed ~= 16 then
        hum.WalkSpeed = 16
    end
    if hum.UseJumpPower and Config.movement.jumpPower and hum.JumpPower ~= Config.movement.jumpPower then
        hum.JumpPower = Config.movement.jumpPower
    end
    if wasFlying and not Config.movement.flyEnabled then
        hrp.Velocity = Vector3.zero
        wasFlying = false
    end
    if Config.movement.flyEnabled == true then
        wasFlying = true
        local moveDir = Vector3.zero
        local camCF = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.yAxis end
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + moveDir.Unit * Config.movement.flySpeed * (1/60)
        end
        hrp.Velocity = Vector3.zero
    end
    if Config.movement.infiniteJump == true then
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) and hrp.Velocity.Y < 40 then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
        end
    end
end

--==================== FARM ====================--
local function getNearestTarget(range)
    local best, bestDist = nil, range or 500
    local myHrp = getHRP()
    if not myHrp then return nil end
    local myPos = myHrp.Position
    for _,plr in pairs(Players:GetPlayers()) do
        if not isValidTarget(plr) then continue end
        local hrp = getHRP(plr)
        if not hrp then continue end
        local d = (hrp.Position - myPos).Magnitude
        if d < bestDist then bestDist = d best = plr end
    end
    return best
end
local farmTick = 0
local function updateFarm()
    if not Config.farm.autoFarm then return end
    farmTick += 1
    if farmTick % 10 ~= 0 then return end
    local t = getNearestTarget(Config.farm.farmRange)
    if not t then return end
    local hrp, tHrp = getHRP(), getHRP(t)
    if hrp and tHrp then hrp.CFrame = CFrame.lookAt(hrp.Position, tHrp.Position) end
end

