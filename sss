-- ============ UTILS ============
local function getCharacter(player)
    return player and player.Character
end

local function getHRP(player)
    local char = getCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    local char = getCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHead(player)
    local char = getCharacter(player)
    return char and char:FindFirstChild("Head")
end

local function isAlive(player)
    local hum = getHumanoid(player)
    return hum and hum.Health > 0
end

local function isWhitelisted(player)
    for _, name in ipairs(Config.Whitelist) do
        if player.Name:lower():find(name:lower()) or player.DisplayName:lower():find(name:lower()) then
            return true
        end
    end
    return false
end

local function isNPC(player)
    return player:FindFirstChild("NPC") ~= nil
end

local function worldToScreen(pos)
    local screen, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screen.X, screen.Y), onScreen, screen.Z
end

local function getDistance(p1, p2)
    return (p1 - p2).Magnitude
end

local function isVisible(targetPart)
    if not Config.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (targetPart.Position - origin)
    local ray = Ray.new(origin, dir)
    local hit, hitPos = Workspace:FindPartOnRay(ray, LocalPlayer.Character)
    if hit and hit:IsDescendantOf(targetPart.Parent) then
        return true
    end
    return false
end

-- ============ DRAWING ============
local function createDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do
        d[k] = v
    end
    table.insert(Drawings, d)
    return d
end

local function cleanupDrawings()
    for _, d in ipairs(Drawings) do
        d:Remove()
    end
    Drawings = {}
end

-- ============ ESP ============
local ESPCache = {}

local function clearESP(player)
    if ESPCache[player] then
        for _, d in pairs(ESPCache[player]) do
            d:Remove()
        end
        ESPCache[player] = nil
    end
end

local function setupESP(player)
    clearESP(player)
    ESPCache[player] = {
        box = createDrawing("Square", {Thickness = 1, Color = Color3.fromRGB(255,0,0), Filled = false, Visible = false}),
        name = createDrawing("Text", {Size = 14, Color = Color3.fromRGB(255,255,255), Center = true, Outline = true, Visible = false}),
        distance = createDrawing("Text", {Size = 12, Color = Color3.fromRGB(200,200,200), Center = true, Outline = true, Visible = false}),
        health = createDrawing("Line", {Thickness = 2, Color = Color3.fromRGB(0,255,0), Visible = false}),
        weapon = createDrawing("Text", {Size = 12, Color = Color3.fromRGB(255,200,0), Center = true, Outline = true, Visible = false}),
    }
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local hrp = getHRP(player)
        local head = getHead(player)
        if not hrp or not head then clearESP(player) continue end
        if Config.SkipNPC and isNPC(player) then clearESP(player) continue end
        
        local esp = ESPCache[player]
        if not esp then setupESP(player) esp = ESPCache[player] end
        
        local headPos, onScreen, depth = worldToScreen(head.Position)
        local hrpPos = worldToScreen(hrp.Position)
        local dist = getDistance(LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero, hrp.Position)
        
        local visible = onScreen and depth > 0 and dist <= Config.LimitDistance
        
        -- Box
        if Config.BoxESP and visible then
            local top = worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
            local bottom = worldToScreen(hrp.Position - Vector3.new(0, 3, 0))
            if top and bottom then
                local height = math.abs(bottom.Y - top.Y)
                local width = height * 0.6
                esp.box.Size = Vector2.new(width, height)
                esp.box.Position = Vector2.new(top.X - width/2, top.Y)
                esp.box.Visible = true
                local hum = getHumanoid(player)
                if hum then
                    local hp = hum.Health / hum.MaxHealth
                    esp.box.Color = Color3.fromRGB(255 * (1-hp), 255 * hp, 0)
                end
            end
        else
            esp.box.Visible = false
        end
        
        -- Name
        if Config.NameESP and visible then
            esp.name.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            esp.name.Position = Vector2.new(headPos.X, headPos.Y - 20)
            esp.name.Visible = true
        else
            esp.name.Visible = false
        end
        
        -- Distance
        if Config.DistanceESP and visible then
            esp.distance.Text = string.format("[%d studs]", dist)
            esp.distance.Position = Vector2.new(headPos.X, esp.name.Position.Y - (Config.NameESP and 16 or 0))
            esp.distance.Visible = true
        else
            esp.distance.Visible = false
        end
        
        -- Health bar
        if Config.HealthBar and visible then
            local hum = getHumanoid(player)
            if hum then
                local hp = hum.Health / hum.MaxHealth
                local top = worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
                local bottom = worldToScreen(hrp.Position - Vector3.new(0, 3, 0))
                if top and bottom then
                    local height = math.abs(bottom.Y - top.Y)
                    esp.health.From = Vector2.new(esp.box.Position.X - 5, bottom.Y)
                    esp.health.To = Vector2.new(esp.box.Position.X - 5, bottom.Y - height * hp)
                    esp.health.Visible = true
                end
            end
        else
            esp.health.Visible = false
        end
        
        -- Weapon
        if Config.WeaponESP and visible then
            local char = getCharacter(player)
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                esp.weapon.Text = tool.Name
                esp.weapon.Position = Vector2.new(headPos.X, bottom and bottom.Y + 10 or headPos.Y + 40)
                esp.weapon.Visible = true
            else
                esp.weapon.Visible = false
            end
        else
            esp.weapon.Visible = false
        end
    end
end

-- ============ AIMBOT ============
local function getClosestTarget()
    local closest = nil
    local closestDist = Config.FOVRadius
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isWhitelisted(player) then continue end
        if not isAlive(player) then continue end
        if Config.SkipNPC and isNPC(player) then continue end
        
        local part = getCharacter(player) and getCharacter(player):FindFirstChild(Config.TargetPart)
        if not part then continue end
        
        local screen, onScreen, depth = worldToScreen(part.Position)
        if not onScreen or depth <= 0 then continue end
        
        local dist = (screen - mousePos).Magnitude
        if dist < closestDist then
            if isVisible(part) then
                closestDist = dist
                closest = {player = player, part = part, screen = screen}
            end
        end
    end
    return closest
end

local function aimAt(target)
    if not target or not target.part then return end
    local part = target.part
    
    -- Prediction
    local aimPos = part.Position
    if Config.Prediction then
        local hrp = getHRP(target.player)
        if hrp then
            local velocity = hrp.AssemblyLinearVelocity
            local dist = getDistance(Camera.CFrame.Position, part.Position)
            local ping = (LocalPlayer:GetNetworkPing() or 0.05) * Config.PingMultiplier
            local travelTime = dist / 3000 * Config.VelocityMultiplier -- rough bullet speed
            aimPos = part.Position + velocity * travelTime + velocity * ping
        end
    end
    
    if Config.AimbotMethod == "CamLock" then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos)
    elseif Config.AimbotMethod == "MouseMove" then
        local screen, onScreen = worldToScreen(aimPos)
        if onScreen then
            local delta = (screen - UserInputService:GetMouseLocation()) / Config.Smoothness
            mousemoverel(delta.X, delta.Y) -- executor-specific
        end
    end
end

-- ============ SILENT AIM ============
local function getSilentTarget()
    local closest = nil
    local closestDist = Config.SilentAimFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isWhitelisted(player) then continue end
        if not isAlive(player) then continue end
        if Config.SkipNPC and isNPC(player) then continue end
        if Config.DeadCheck and not isAlive(player) then continue end
        
        local part = getCharacter(player) and getCharacter(player):FindFirstChild(Config.SilentAimHitpart)
        if not part then continue end
        
        local screen, onScreen, depth = worldToScreen(part.Position)
        if not onScreen or depth <= 0 then continue end
        
        local dist = (screen - mousePos).Magnitude
        if dist < closestDist and isVisible(part) then
            closestDist = dist
            closest = {player = player, part = part}
        end
    end
    return closest
end

-- Silent aim hook via namecall (executor dependent)
local oldNamecall
local function hookSilentAim()
    if not Config.SilentAimEnabled then return end
    if not hookmetamethod or not getnamecallmethod then return end
    
    oldNamecall = oldNamecall or hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if Config.SilentAimEnabled and (method == "Fire" or method == "InvokeServer" or method == "FireServer") then
            local target = getSilentTarget()
            if target and target.part then
                local args = {...}
                if args[1] and typeof(args[1]) == "CFrame" then
                    args[1] = CFrame.new(Camera.CFrame.Position, target.part.Position)
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

-- ============ TRIGGERBOT ============
local function doTriggerBot()
    if not Config.TriggerBot then return end
    local mousePos = UserInputService:GetMouseLocation()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or isWhitelisted(player) then continue end
        if not isAlive(player) then continue end
        local char = getCharacter(player)
        if not char then continue end
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local screen, onScreen, depth = worldToScreen(part.Position)
                if onScreen and depth > 0 and (screen - mousePos).Magnitude < 20 then
                    if isVisible(part) then
                        -- fire mouse click
                        if mousemoveabs and mouse1click then
                            mouse1click()
                        end
                        return
                    end
                end
            end
        end
    end
end

-- ============ MOVEMENT ============
local function setWalkSpeed(speed)
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = speed
    end
end

local function toggleFly(state)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    if state then
        if Config.NoEquipFly and char:FindFirstChildOfClass("Tool") then return end
        FlyBV = Instance.new("BodyVelocity")
        FlyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        FlyBV.Velocity = Vector3.zero
        FlyBV.Parent = hrp
        FlyBG = Instance.new("BodyGyro")
        FlyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        FlyBG.P = 1000
        FlyBG.Parent = hrp
        Flying = true
    else
        if FlyBV then FlyBV:Destroy() FlyBV = nil end
        if FlyBG then FlyBG:Destroy() FlyBG = nil end
        Flying = false
    end
end

local function updateFly()
    if not Flying or not FlyBV or not FlyBG then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local moveDir = Vector3.zero
    local camCF = Camera.CFrame
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0,1,0) end
    FlyBV.Velocity = moveDir * 50
    FlyBG.CFrame = camCF
end

local function toggleNoClip(state)
    if state then
        local conn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
        table.insert(Connections, conn)
    else
        for _, conn in ipairs(Connections) do conn:Disconnect() end
        Connections = {}
        if LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end

local function toggleLowGraphics(state)
    if state then
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Lighting") then v.Enabled = false end
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") then v.Enabled = false end
        end
    else
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level10
    end
end

