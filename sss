        if C.aimSticky and currentTarget and alive(currentTarget.player) then
            local p = currentTarget.player
            local part = char(p) and char(p):FindFirstChild(C.aimPart)
            if part then
                local s,on = screen(part.Position)
                if on and (s-UserInputService:GetMouseLocation()).Magnitude < C.aimFovRadius then
                    aimAt({player=p, part=part})
                else currentTarget=nil end
            else currentTarget=nil end
        else
            currentTarget = findTarget(C.aimFovRadius)
            if currentTarget then aimAt(currentTarget) end
        end
    end

