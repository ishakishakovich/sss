local espObjects = {}
local function createESP(plr)
    if espObjects[plr] then return end
    local obj = {
        box = newDrawing("Square",{Thickness=1,Filled=false,Visible=false}),
        name = newDrawing("Text",{Size=14,Center=true,Outline=true,Visible=false}),
        health = newDrawing("Square",{Thickness=1,Filled=true,Visible=false}),
        dist = newDrawing("Text",{Size=12,Center=true,Outline=true,Visible=false}),
        tracer = newDrawing("Line",{Thickness=1,Visible=false}),
        weapon = newDrawing("Text",{Size=11,Center=true,Outline=true,Visible=false}),
        skeleton = {},
    }
    for i=1,5 do obj.skeleton[i] = newDrawing("Line",{Thickness=1,Visible=false}) end
    espObjects[plr] = obj
end
local function removeESP(plr)
    local o = espObjects[plr]
    if not o then return end
    for _,v in pairs(o) do
        if type(v)=="table" then
            for _,d in ipairs(v) do safe(function() d:Remove() end) end
        else safe(function() v:Remove() end) end
    end
    espObjects[plr] = nil
end
local function hideObj(o)
    for _,v in pairs(o) do
        if type(v)=="table" then for _,d in ipairs(v) do safe(function() d.Visible=false end) end
        else safe(function() v.Visible=false end) end
    end
end
local function purgeESP()
    for plr, o in pairs(espObjects) do
        if not plr.Parent then
            removeESP(plr)
        elseif not plr.Character then
            hideObj(o)
        end
    end
end
local function getSkeletonPoints(plr)
    local char = plr.Character
    if not char then return nil end
    local function v(n) local p = char:FindFirstChild(n) return p and p.Position end
    return {
        head = v("Head"),
        hrp = v("HumanoidRootPart"),
        lhand = v("LeftHand") or v("Left Arm"),
        rhand = v("RightHand") or v("Right Arm"),
        lfoot = v("LeftFoot") or v("Left Leg"),
        rfoot = v("RightFoot") or v("Right Leg"),
    }
end

local espTick = 0
local function updateESP()
    espTick += 1
    if espTick % 4 ~= 0 then return end
    if not Config.esp.enabled then
        for _,o in pairs(espObjects) do hideObj(o) end
        return
    end
    for plr,o in pairs(espObjects) do
        local char = plr.Character
        if plr==LocalPlayer or not char then hideObj(o) continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health<=0 then hideObj(o) continue end
        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
        if dist > Config.esp.maxDist then hideObj(o) continue end
        local sameTeam = Config.esp.teamCheck and LocalPlayer.Team and plr.Team==LocalPlayer.Team
        local color = sameTeam and Config.esp.teamColor or Config.esp.color
        local head = hrp.Position + Vector3.new(0,1.8,0)
        local feet = hrp.Position - Vector3.new(0,2.9,0)
        local headV, headOn = Camera:WorldToViewportPoint(head)
        local feetV, feetOn = Camera:WorldToViewportPoint(feet)
        if not (headOn and feetOn) then hideObj(o) continue end
        local height = math.abs(feetV.Y - headV.Y)
        local width = height * 0.55
        local x, y = headV.X - width/2, headV.Y
        o.box.Visible = Config.esp.boxes
        if Config.esp.boxes then
            o.box.Size = Vector2.new(width, height)
            o.box.Position = Vector2.new(x, y)
            o.box.Color = color
        end
        o.name.Visible = Config.esp.names
        if Config.esp.names then
            o.name.Text = plr.Name
            o.name.Color = color
            o.name.Position = Vector2.new(headV.X, y - 18)
        end
        o.health.Visible = Config.esp.health
        if Config.esp.health then
            local hp = hum.Health / hum.MaxHealth
            o.health.Size = Vector2.new(3, height*hp)
            o.health.Position = Vector2.new(x - 6, y + height*(1-hp))
            o.health.Color = Color3.fromRGB(math.floor(255*(1-hp)), math.floor(255*hp), 0)
        end
        o.dist.Visible = Config.esp.distance
        if Config.esp.distance then
            o.dist.Text = string.format("[%d m]", math.floor(dist/3))
            o.dist.Color = color
            o.dist.Position = Vector2.new(headV.X, y + height + 4)
        end
        o.tracer.Visible = Config.esp.tracers
        if Config.esp.tracers then
            o.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            o.tracer.To = Vector2.new(headV.X, y + height)
            o.tracer.Color = color
        end
        o.weapon.Visible = Config.esp.weapon
        if Config.esp.weapon then
            local wep = char:FindFirstChildWhichIsA("Tool")
            o.weapon.Text = wep and wep.Name or "—"
            o.weapon.Color = color
            o.weapon.Position = Vector2.new(headV.X, y + height + 18)
        end
        if Config.esp.skeleton then
            local sk = getSkeletonPoints(plr)
            local pts = {}
            if sk then
                for _,p in pairs(sk) do
                    if p then
                        local v2, on = Camera:WorldToViewportPoint(p)
                        if on then pts[#pts+1] = Vector2.new(v2.X, v2.Y) end
                    end
                end
            end
            local links = {{1,2},{2,3},{2,4},{2,5},{2,6}}
            for i,d in ipairs(o.skeleton) do
                local l = links[i]
                if l and pts[l[1]] and pts[l[2]] then
                    d.Visible = true
                    d.From = pts[l[1]]
                    d.To = pts[l[2]]
                    d.Color = color
                else
                    d.Visible = false
                end
            end
        else
            for _,d in ipairs(o.skeleton) do d.Visible = false end
        end
    end
end

