local function tweenTo(pos, dur)
    local hrp = getHRP()
    if not hrp then return end
    local tw = TweenService:Create(hrp, TweenInfo.new(dur or 0.2, Enum.EasingStyle.Quad), {CFrame = CFrame.new(pos)})
    tw:Play()
end
local function tpToPlayer(plr)
    local hrp, myHrp = getHRP(plr), getHRP()
    if hrp and myHrp then tweenTo(hrp.Position + Vector3.new(0,3,0), 0.2) end
end
local function tpToPos(x,y,z) tweenTo(Vector3.new(x,y,z), 0.2) end
local function tpRandom()
    local list = {}
    for _,p in ipairs(Players:GetPlayers()) do if isValidTarget(p) then table.insert(list, p) end end
    if #list > 0 then tpToPlayer(list[math.random(1,#list)]) end
end

