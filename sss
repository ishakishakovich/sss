local ESP = {}
local function clearESP(p)
    local t = ESP[p]; if not t then return end
    for _,d in pairs(t) do pcall(function() d:Remove() end) end
    ESP[p] = nil
end

local function initESP(p)
    clearESP(p)
    ESP[p] = {
        box     = mkDraw("Square", {Thickness=1, Color=Color3.fromRGB(255,0,100), Filled=false, Visible=false}),
        boxFill = mkDraw("Square", {Thickness=0, Color=Color3.fromRGB(255,0,100), Filled=true, Transparency=0.75, Visible=false}),
        name    = mkDraw("Text", {Size=13, Color=Color3.fromRGB(255,255,255), Center=true, Outline=true, Visible=false}),
        dist    = mkDraw("Text", {Size=11, Color=Color3.fromRGB(200,200,200), Center=true, Outline=true, Visible=false}),
        hpBg    = mkDraw("Line", {Thickness=3, Color=Color3.fromRGB(40,40,40), Visible=false}),
        hpBar   = mkDraw("Line", {Thickness=3, Color=Color3.fromRGB(0,255,100), Visible=false}),
        weapon  = mkDraw("Text", {Size=11, Color=Color3.fromRGB(255,200,0), Center=true, Outline=true, Visible=false}),
        lock    = mkDraw("Text", {Size=12, Color=Color3.fromRGB(255,0,100), Center=true, Outline=true, Visible=false}),
    }
end

local skelPool = {}
local function projectSkeleton(ch)
    local parts = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},
    }
    local segs = {}
    for _,pair in ipairs(parts) do
        local a = ch:FindFirstChild(pair[1]); local b = ch:FindFirstChild(pair[2])
        if a and b then
            local s1,on1,d1 = screen(a.Position)
            local s2,on2,d2 = screen(b.Position)
            if on1 and on2 and d1>0 and d2>0 then table.insert(segs,{s1,s2}) end
        end
    end
    return segs
end

local function updateSkeleton(p, ch, vis)
    skelPool[p] = skelPool[p] or {}
    local pool = skelPool[p]
    local segs = (vis and C.espSkeleton) and projectSkeleton(ch) or {}
    for i=1,#segs do
        if not pool[i] then pool[i] = mkDraw("Line", {Thickness=1, Color=Color3.fromRGB(255,0,100), Visible=false}) end
        pool[i].From = segs[i][1]; pool[i].To = segs[i][2]; pool[i].Visible = true
    end
    for i=#segs+1,#pool do pool[i].Visible = false end
end

local function updateESP()
    local lpPos = hrp(LP) and hrp(LP).Position or Vector3.zero
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local h = hrp(p); local hd = head(p)
        if not h or not hd then clearESP(p) continue end
        if C.espSkipNpc and isNPC(p) then clearESP(p) continue end
        if not ESP[p] then initESP(p) end
        local e = ESP[p]
        local hs, onS, depth = screen(hd.Position)
        local d = dist(lpPos, h.Position)
        local vis = onS and depth>0 and d<=C.espLimit

        if C.espBox and vis then
            local top = screen(hd.Position + Vector3.new(0,0.5,0))
            local bot = screen(h.Position - Vector3.new(0,3,0))
            if top and bot then
                local height = math.abs(bot.Y - top.Y)
                local width = height*0.6
                e.box.Size = Vector2.new(width,height)
                e.box.Position = Vector2.new(top.X-width/2, top.Y)
                e.box.Visible = true
                if C.espBoxFill then
                    e.boxFill.Size = e.box.Size; e.boxFill.Position = e.box.Position; e.boxFill.Visible = true
                else e.boxFill.Visible=false end
                local human = hum(p)
                if human then
                    local ratio = human.Health/human.MaxHealth
                    e.box.Color = Color3.fromRGB(255*(1-ratio), 255*ratio, 0)
                    e.boxFill.Color = e.box.Color
                end
            end
        else e.box.Visible=false; e.boxFill.Visible=false end

        if C.espName and vis then
            e.name.Text = p.DisplayName.." (@"..p.Name..")"
            e.name.Position = Vector2.new(hs.X, hs.Y - 22)
            e.name.Visible = true
        else e.name.Visible=false end

        if C.espDistance and vis then
            e.dist.Text = string.format("[%d studs]", d)
            e.dist.Position = Vector2.new(hs.X, e.name.Position.Y + (C.espName and 14 or 0))
            e.dist.Visible = true
        else e.dist.Visible=false end

        if C.espHealth and vis and e.box.Visible then
            local human = hum(p)
            if human then
                local ratio = math.clamp(human.Health/human.MaxHealth, 0, 1)
                local top = screen(hd.Position + Vector3.new(0,0.5,0))
                local bot = screen(h.Position - Vector3.new(0,3,0))
                if top and bot then
                    local hx = e.box.Position.X - 6
                    e.hpBg.From = Vector2.new(hx, bot.Y); e.hpBg.To = Vector2.new(hx, top.Y); e.hpBg.Visible = true
                    e.hpBar.From = Vector2.new(hx, bot.Y); e.hpBar.To = Vector2.new(hx, bot.Y - (bot.Y-top.Y)*ratio)
                    e.hpBar.Color = Color3.fromRGB(255*(1-ratio),255*ratio,0); e.hpBar.Visible = true
                end
            end
        else e.hpBg.Visible=false; e.hpBar.Visible=false end

        if C.espWeapon and vis then
            local tool = char(p) and char(p):FindFirstChildOfClass("Tool")
            if tool then
                e.weapon.Text = tool.Name
                e.weapon.Position = Vector2.new(hs.X, e.name.Position.Y - 16)
                e.weapon.Visible = true
            else e.weapon.Visible = false end
        else e.weapon.Visible = false end

        -- lock indicator
        if isLocked(p) and vis then
            e.lock.Text = "◉ LOCKED"
            e.lock.Position = Vector2.new(hs.X, hs.Y - 38)
            e.lock.Visible = true
        else e.lock.Visible = false end

        updateSkeleton(p, char(p), vis)
    end
end

-- ============================================================
-- LOCK SYSTEM (multi-lock)
-- ============================================================
local function lockPlayer(p)
    if not p or p==LP then return end
    if C.lockMode == "Single" then
        C.lockedPlayers = {}
    end
    C.lockedPlayers[p] = true
end

local function unlockPlayer(p)
    C.lockedPlayers[p] = nil
end

local function toggleLock(p)
    if isLocked(p) then unlockPlayer(p) else lockPlayer(p) end
end

local function cleanLocks()
    -- remove dead / left players from locks
    for p in pairs(C.lockedPlayers) do
        if not p.Parent or not alive(p) then
            C.lockedPlayers[p] = nil
        end
    end
end

-- get preferred target: locked alive > nearest in FOV
local function findTarget(fov)
    local mouse = UserInputService:GetMouseLocation()
    -- 1) locked players first
    local best, bd = nil, fov
    for p in pairs(C.lockedPlayers) do
        if p and p.Parent and alive(p) then
            local part = char(p) and char(p):FindFirstChild(C.aimPart)
            if part and visible(part) then
                local s,on,dp = screen(part.Position)
                if on and dp>0 then
                    local dd = (s-mouse).Magnitude
                    if dd<bd then bd=dd; best={player=p, part=part} end
                end
            end
        end
    end
    if best then return best end
    -- 2) fallback to any player in FOV
    local closest, cd = nil, fov
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        if isLocked(p) then continue end
        if not alive(p) then continue end
        if C.espSkipNpc and isNPC(p) then continue end
        local part = char(p) and char(p):FindFirstChild(C.aimPart)
        if not part then continue end
        local s,on,dp = screen(part.Position)
        if not on or dp<=0 then continue end
        local dd = (s-mouse).Magnitude
        if dd<cd and visible(part) then cd=dd; closest={player=p, part=part} end
    end
    return closest
end

local function predictPos(p, part)
    if not C.aimPrediction then return part.Position end
    local h = hrp(p); if not h then return part.Position end
    local v = h.AssemblyLinearVelocity
    local ping = (LP:GetNetworkPing() or 0.05) * C.aimPingMult
    local d = dist(Camera.CFrame.Position, part.Position)
    local t = (d / 3000) * C.aimVelMult
    return part.Position + v*t + v*ping
end

local function aimAt(target)
    if not target or not target.part then return end
    local aimPos = predictPos(target.player, target.part)
    if C.aimMethod == "CamLock" then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, aimPos), 1/C.aimSmooth)
    elseif C.aimMethod == "MouseMove" then
        local s,on = screen(aimPos)
        if on then
            local delta = (s - UserInputService:GetMouseLocation()) / C.aimSmooth
            if mousemoverel then mousemoverel(delta.X, delta.Y) end
        end
    end
end

-- ============================================================
-- SILENT AIM (namecall hook)
-- ============================================================
local oldNamecall = nil
local function installSilentHook()
    if oldNamecall then return end
    if not hookmetamethod or not getnamecallmethod then return end
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if C.silEnabled and (method=="Fire" or method=="FireServer" or method=="InvokeServer") then
            local args = {...}
            if args[1] and typeof(args[1])=="CFrame" then
                local best, bd = nil, C.silFov
                local mouse = UserInputService:GetMouseLocation()
                -- prioritize locked
                for p in pairs(C.lockedPlayers) do
                    if p and p.Parent and alive(p) then
                        local part = char(p) and char(p):FindFirstChild(C.silPart)
                        if part and visible(part) then
                            local s,on,dp = screen(part.Position)
                            if on and dp>0 then
                                local dd = (s-mouse).Magnitude
                                if dd<bd then bd=dd; best=part end
                            end
                        end
                    end
                end
                -- fallback any player
                if not best then
                    for _,p in ipairs(Players:GetPlayers()) do
                        if p==LP or isLocked(p) then continue end
                        if not alive(p) then continue end
                        if C.espSkipNpc and isNPC(p) then continue end
                        local part = char(p) and char(p):FindFirstChild(C.silPart)
                        if part and visible(part) then
                            local s,on,dp = screen(part.Position)
                            if on and dp>0 then
                                local dd = (s-mouse).Magnitude
                                if dd<bd then bd=dd; best=part end
                            end
                        end
                    end
                end
                if best then
                    args[1] = CFrame.new(Camera.CFrame.Position, best.Position)
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

-- ============================================================
-- TRIGGERBOT
-- ============================================================
local nextTrigger = 0
local function triggerTick()
    if not C.aimTrigger then return end
    local now = tick()
    if now < nextTrigger then return end
    local mouse = UserInputService:GetMouseLocation()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP or not alive(p) then continue end
        local c = char(p); if not c then continue end
        for _,part in ipairs(c:GetChildren()) do
            if part:IsA("BasePart") then
                local s,on,dp = screen(part.Position)
                if on and dp>0 and (s-mouse).Magnitude < 15 and visible(part) then
                    if mouse1click then mouse1click() end
                    nextTrigger = now + C.aimTriggerDelay/1000
                    return
                end
            end
        end
    end
end

-- ============================================================
-- MOVEMENT
-- ============================================================
local FlyBV, FlyBG
local function setSpeed(v) local h=hum(LP); if h then h.WalkSpeed=v end end
local function toggleFly(state)
    local c = char(LP); if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart")
    if not h then return end
    if state then
        if C.noEquipFly and c:FindFirstChildOfClass("Tool") then return end
        FlyBV = Instance.new("BodyVelocity"); FlyBV.MaxForce=Vector3.new(1e5,1e5,1e5); FlyBV.Velocity=Vector3.zero; FlyBV.Parent=h
        FlyBG = Instance.new("BodyGyro"); FlyBG.MaxTorque=Vector3.new(1e5,1e5,1e5); FlyBG.P=1000; FlyBG.Parent=h
    else
        if FlyBV then FlyBV:Destroy() end
        if FlyBG then FlyBG:Destroy() end
        FlyBV, FlyBG = nil, nil
    end
end
local function flyTick()
    if not FlyBV or not FlyBG then return end
    local h = hrp(LP); if not h then return end
    local mv = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv -= Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv += Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0,1,0) end
    FlyBV.Velocity = mv * 60; FlyBG.CFrame = Camera.CFrame
end
local function noclipTick()
    if not C.noclip then return end
    local c = char(LP); if not c then return end
    for _,part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false end
    end
end

