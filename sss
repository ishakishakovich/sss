local function makePlayerButton(player)
    local button = create("TextButton", list, {
        Name = player.Name,
        Size = UDim2.new(1, -4, 0, 48),
        BackgroundColor3 = Color3.fromRGB(36, 34, 51),
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = 0
    })
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    create("TextLabel", button, {
        Size = UDim2.new(1, -12, 0, 22),
        Position = UDim2.fromOffset(8, 4),
        BackgroundTransparency = 1,
        Text = player.DisplayName,
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })

    create("TextLabel", button, {
        Size = UDim2.new(1, -12, 0, 16),
        Position = UDim2.fromOffset(8, 26),
        BackgroundTransparency = 1,
        Text = "@" .. player.Name,
        TextColor3 = Muted,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })

    button.MouseButton1Click:Connect(function()
        selectedPlayer = player
        selectedLabel.Text = player.DisplayName .. "\n@" .. player.Name
        status.Text = "PLAYER SELECTED"
    end)
end

refresh = function()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local query = string.lower(search.Text)

    for _, player in ipairs(Players:GetPlayers()) do
        local matches = string.find(
            string.lower(player.Name .. " " .. player.DisplayName),
            query,
            1,
            true
        )

        if matches then
            makePlayerButton(player)
        end
    end

    task.defer(function()
        list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 14)
    end)
end

search:GetPropertyChangedSignal("Text"):Connect(refresh)
Players.PlayerAdded:Connect(refresh)
Players.PlayerRemoving:Connect(function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        selectedLabel.Text = "SELECT A PLAYER"
        status.Text = "PLAYER LEFT"
    end
    refresh()
end)

reloadButton.MouseButton1Click:Connect(function()
    if running then
        return
    end

    local seconds = tonumber(duration.Text)
    if not seconds or seconds < 0.1 or seconds > 10 then
        status.Text = "USE 0.1 - 10 SECONDS"
        return
    end

    running = true
    reloadButton.Text = "RELOADING..."
    status.Text = "TRAINING IN PROGRESS"

    local started = os.clock()
    while os.clock() - started < seconds do
        status.Text = string.format(
            "TIME LEFT: %.1f S",
            math.max(0, seconds - (os.clock() - started))
        )
        task.wait(0.05)
    end

    status.Text = "DRILL COMPLETE"
    reloadButton.Text = "START RELOAD DRILL"
    running = false
end)

local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

refresh()
