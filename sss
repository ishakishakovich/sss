local function shakeCamera(intensity, duration)
    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if tick() - start > (duration or 1) then conn:Disconnect() return end
        Camera.CFrame = Camera.CFrame * CFrame.Angles(
